+## webr-for-brms: rstan from a pinned archive of its git repository, whose package
+## directory is not at the top, so it is turned into a source tarball first.
+build_pinned_rstan <- function(dest) {
+  archive <- file.path(dirname(dest), "rstan-upstream.tar.gz")
+  say("downloading rstan: ", pin("RSTAN_URL"))
+  utils::download.file(pin("RSTAN_URL"), archive, mode = "wb", quiet = TRUE)
+  got <- unname(tools::sha256sum(archive))
+  if (!identical(got, pin("RSTAN_SHA256"))) {
+    stop("rstan archive has sha256 ", got, ", expected ", pin("RSTAN_SHA256"))
+  }
+  src <- file.path(dirname(dest), "rstan-upstream")
+  untar(archive, exdir = src)
+  pkg_dir <- file.path(list.dirs(src, recursive = FALSE), pin("RSTAN_SUBDIR"))
+  if (length(pkg_dir) != 1L || !file.exists(file.path(pkg_dir, "DESCRIPTION"))) {
+    stop("no package at ", pin("RSTAN_SUBDIR"), " in ", pin("RSTAN_URL"))
+  }
+  old <- setwd(dirname(dest))
+  on.exit(setwd(old))
+  status <- system2(file.path(R.home("bin"), "R"),
+                    c("CMD", "build", "--no-build-vignettes", "--no-manual", shQuote(pkg_dir)))
+  if (!identical(as.integer(status), 0L) || !file.exists(dest)) {
+    stop("R CMD build of ", pkg_dir, " did not produce ", basename(dest))
+  }
+}
