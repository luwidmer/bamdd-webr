         {
-            auto* const end = std::remove(number_buffer.begin(),
+            auto const end = std::remove(number_buffer.begin(),
                                           number_buffer.begin() + len, thousands_sep);
             std::fill(end, number_buffer.end(), '\0');
             JSON_ASSERT((end - number_buffer.begin()) <= len);
@@ -17108,7 +17108,7 @@
