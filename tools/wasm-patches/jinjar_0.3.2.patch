-            auto* const dec_pos = std::find(number_buffer.begin(), number_buffer.end(), decimal_point);
+            auto const dec_pos = std::find(number_buffer.begin(), number_buffer.end(), decimal_point);
             if (dec_pos != number_buffer.end())
