# Everything here is regenerated by tools/ — see README "Building".

# Nothing under vendor/ is committed. webR (fetch-webr.sh), xterm.js and
# CodeMirror (fetch-ui-libs.sh), the downloaded wasm tarballs (build-library.R) and the
# cross-compiled ones (vendor-wasm-repo.R) are all build outputs. Reproducing the last
# group needs Docker *and* the RBesT source tree, which is not part of this repository --
# see README "Build" before running build-library.R.
vendor/

# Unpacked wasm R library staging area (tools/build-library.R)
build/

# Built VFS filesystem image (tools/pack-library.R)
lib/*.data
lib/*.data.gz
lib/*.js
lib/*.js.metadata
lib/*.tar
lib/*.tar.gz
lib/*.tgz

# Deployable static site (tools/make-dist.sh)
dist/

# Dev-only tooling for tools/smoke-test.mjs
node_modules/

# webR's synchronous-XHR shim under Node (tools/test-packages.mjs) leaves these behind
.node-xmlhttprequest-*

# wrangler's local state (tools/deploy.sh)
.wrangler/

.DS_Store
*.log
.Rproj.user
.Rhistory
